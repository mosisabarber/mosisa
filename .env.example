# Copy this file to .env.local for local development, and set the same
# variables in Vercel for deployments. Never commit real .env files.

# Neon Postgres connection string (used from Stage 2 on)
DATABASE_URL=

# Better Auth (Stage 8 — admin/staff login)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Vercel Blob (image storage, Stage 10)
BLOB_READ_WRITE_TOKEN=

# Resend transactional email (Stage 6)
RESEND_API_KEY=

# SMSEthiopia (Stage 6) — KEY-header API key from smsethiopia.com
# (Console → API Keys). Sends go to POST /api/sms/send with {msisdn, text}.
SMSETHIOPIA_API_KEY=

# Optional: "From" header for booking emails. Resend's default testing sender
# (onboarding@resend.dev) only delivers to your own account address — to send
# to real customers, verify your domain at resend.com/domains and set:
#   EMAIL_FROM="Mosisa Barber Shop <bookings@yourdomain.com>"
EMAIL_FROM=

# Public site URL, used to build confirmation / management links
NEXT_PUBLIC_SITE_URL=
